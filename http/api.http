### HTTP requests for IntelliJ HTTP Client

@base = http://127.0.0.1:48121
@token = {{register.response.body.accessToken}}

### Health
GET {{base}}/actuator/health

### Register
# @name register
POST {{base}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "you@example.com",
  "password": "password1",
  "displayName": "You"
}

### Login
POST {{base}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "you@example.com",
  "password": "password1"
}

### Me
GET {{base}}/api/v1/auth/me
Authorization: Bearer {{token}}

### Create stock portfolio
# @name createStock
POST {{base}}/api/v1/stock-portfolios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Брокер",
  "description": "ИИС"
}

### List stock portfolios
GET {{base}}/api/v1/stock-portfolios
Authorization: Bearer {{token}}

### Add stock holding (first BUY)
# @name addStockHolding
POST {{base}}/api/v1/stock-portfolios/{{createStock.response.body.id}}/holdings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "symbol": "SBER",
  "name": "Сбербанк",
  "quantity": 10,
  "occurredOn": "2026-09-01"
}

### Search MOEX instruments
GET {{base}}/api/v1/instruments?q=sber&market=MOEX
Authorization: Bearer {{token}}

### Search crypto instruments
GET {{base}}/api/v1/instruments?q=bitcoin&market=CRYPTO
Authorization: Bearer {{token}}

### Buy more stock
POST {{base}}/api/v1/stock-portfolios/{{createStock.response.body.id}}/holdings/{{addStockHolding.response.body.id}}/buys
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 2.5,
  "occurredOn": "2026-09-04"
}

### Sell stock
POST {{base}}/api/v1/stock-portfolios/{{createStock.response.body.id}}/holdings/{{addStockHolding.response.body.id}}/sells
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 1,
  "occurredOn": "2026-09-04"
}

### Stock holding transactions
GET {{base}}/api/v1/stock-portfolios/{{createStock.response.body.id}}/holdings/{{addStockHolding.response.body.id}}/transactions
Authorization: Bearer {{token}}

### Stock portfolio detail
GET {{base}}/api/v1/stock-portfolios/{{createStock.response.body.id}}
Authorization: Bearer {{token}}

### Create crypto portfolio
# @name createCrypto
POST {{base}}/api/v1/crypto-portfolios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Cold wallet"
}

### Add crypto holding (first BUY)
# @name addCryptoHolding
POST {{base}}/api/v1/crypto-portfolios/{{createCrypto.response.body.id}}/holdings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "symbol": "BTC",
  "name": "Bitcoin",
  "quantity": 0.01,
  "occurredOn": "2026-09-01"
}

### Crypto holding transactions
GET {{base}}/api/v1/crypto-portfolios/{{createCrypto.response.body.id}}/holdings/{{addCryptoHolding.response.body.id}}/transactions
Authorization: Bearer {{token}}

### Expense categories
GET {{base}}/api/v1/expense-categories
Authorization: Bearer {{token}}

### Create expense
POST {{base}}/api/v1/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "category": "GROCERIES",
  "amount": 15000.00,
  "currency": "RUB",
  "yearMonth": "2026-08",
  "note": "Август"
}

### List expenses
GET {{base}}/api/v1/expenses?from=2026-08&to=2026-09
Authorization: Bearer {{token}}
